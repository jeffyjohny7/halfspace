# Copy to .env and fill in (setup-foundry.ps1 writes these for you). Keyless: run az login first.
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-5-mini

# Optional
# FOUNDRY_WRITER_MODEL=<second deployment for Spanish, Arabic, Hindi, Malayalam>
# AGENT_REASONING_EFFORT=low
# AGENT_TRANSLATION_REASONING_EFFORT=medium
# HALFSPACE_TRACE=1                       # same as --trace: send traces to the Foundry project
# HALFSPACE_TRACE_CONTENT=1               # same as --trace-content: include prompts, replies, tool results
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/   # judge endpoint for eval_agents.py (derived by default)
